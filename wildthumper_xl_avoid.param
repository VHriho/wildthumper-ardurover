# Лідар через MAVLink (OBSTACLE_DISTANCE) + ухилення від перешкод
# Ровер 2.00 x 1.42 м: від центру до борту 0.71 м. Усі запаси рахуються від центру ровера.
PRX1_TYPE        2      # датчик близькості = MAVLink (міст lidar_to_mavlink.py)
AVOID_ENABLE     1      # лише геозона. Біт1 (гальмування AC_Avoid за лідаром) вимкнено:
                        # між деревами він обнуляв швидкість, і ровер завмирав після об'їзду.
                        # Аварійне гальмо за лідаром - окремим Lua-сторожем (етап 5).
AVOID_MARGIN     0.9    # м від центру (~0.2 м від борту) - якщо біт1 увімкнуть знову
AVOID_BEHAVE     0      # ковзати вздовж перешкоди/межі (1 = стоп)
AVOID_BACKUP_SPD 0.3    # м/с, повільний відкат без "гойдалки"
OA_TYPE          1      # об'їзд маршруту: BendyRuler (працює за даними лідара незалежно від AVOID_ENABLE)
OA_BR_LOOKAHEAD  15     # м, на скільки вперед BendyRuler шукає вільний шлях
OA_MARGIN_MAX    1.2    # м від центру = ~0.5 м від борту при об'їзді
OA_DB_BEAM_WIDTH 2      # град, "роздування" точок лідара в базі перешкод (було 5)
OA_DB_EXPIRE     3      # с, скільки пам'ятати точку лідара (було 10)
WP_PIVOT_ANGLE   30     # град, більша помилка курсу - розворот на місці (skid-steer)
WP_PIVOT_RATE    60     # град/с, швидкість розвороту на місці
WP_SPEED         4.0    # м/с у GUIDED/AUTO
